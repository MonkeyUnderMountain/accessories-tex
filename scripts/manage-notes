#!/usr/bin/env python3
"""Manage the chapters, sections, and public build manifest of this LaTeX note."""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import unicodedata
from pathlib import Path
from typing import Any


STATUSES = (
    "finished-published",
    "draft-published",
    "draft-unpublished",
)
SLUG_RE = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
SELECTOR_RE = re.compile(r"^([1-9][0-9]*)(?:\.([1-9][0-9]*))?$")
SECTION_IN_BODY_RE = re.compile(r"^\s*\\section(?:\[[^\]]*\])?\{", re.MULTILINE)
DOCUMENTCLASS_RE = re.compile(r"^\s*\\documentclass(?:\[|\{)", re.MULTILINE)
TITLE_RE = re.compile(r"^\\title\{.*\}$", re.MULTILINE)
WATERMARK_RE = re.compile(
    r"^\s*%?\s*\\usepackage\{draftwatermark\}(?:\s*%.*)?$"
)
ENGINE_HEAD = "% !TeX program = xelatex"


class ManageNotesError(RuntimeError):
    """An error that can be reported without a traceback."""


def find_repo_root() -> Path:
    configured = os.environ.get("MANAGE_NOTES_ROOT")
    if configured:
        root = Path(configured).expanduser().resolve()
        if not root.is_dir():
            raise ManageNotesError(f"Repository root does not exist: {root}")
        return root

    script_dir = Path(__file__).resolve().parent
    result = subprocess.run(
        ["git", "-C", str(script_dir), "rev-parse", "--show-superproject-working-tree"],
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode == 0 and result.stdout.strip():
        return Path(result.stdout.strip()).resolve()

    candidate = script_dir.parents[1]
    if (candidate / ".git").exists():
        return candidate
    raise ManageNotesError(
        "Could not find the parent note repository. Set MANAGE_NOTES_ROOT."
    )


ROOT = find_repo_root()
MANIFEST_NAME = os.environ.get("MANAGE_NOTES_MANIFEST", "notes.json")
MANIFEST = ROOT / MANIFEST_NAME
CHAPTERS_DIR = ROOT / "chapters"


def fail(message: str) -> None:
    raise ManageNotesError(message)


def require_slug(value: str) -> str:
    if not SLUG_RE.fullmatch(value):
        fail("Slugs must use lowercase letters, numbers, and single hyphens.")
    return value


def require_title(value: str) -> str:
    if not value or any(character in value for character in "\t\r\n"):
        fail("Titles must be nonempty, fit on one line, and contain no tabs.")
    return value


def require_status(value: str) -> str:
    if value not in STATUSES:
        fail(
            "Status must be finished-published, draft-published, "
            "or draft-unpublished."
        )
    return value


def require_order(value: int, maximum: int) -> int:
    if value < 1 or value > maximum:
        fail(f"Order must be between 1 and {maximum}.")
    return value


def slugify(value: str) -> str:
    normalized = unicodedata.normalize("NFKD", require_title(value))
    ascii_value = normalized.encode("ascii", "ignore").decode("ascii").lower()
    slug = re.sub(r"[^a-z0-9]+", "-", ascii_value).strip("-")
    if not slug:
        fail("The title must contain letters or numbers for a generated filename.")
    return require_slug(slug)


def unique_slug(value: str, existing: set[str]) -> str:
    base = slugify(value)
    if base not in existing:
        return base
    suffix = 2
    while f"{base}-{suffix}" in existing:
        suffix += 1
    return f"{base}-{suffix}"


def parse_selector(value: str) -> tuple[int, int | None]:
    match = SELECTOR_RE.fullmatch(value.strip())
    if match is None:
        fail("Use an order such as 2 for a chapter or 2.3 for a section.")
    chapter_order = int(match.group(1))
    section_order = int(match.group(2)) if match.group(2) else None
    return chapter_order, section_order


def select_item(
    data: dict[str, Any], selector: str
) -> tuple[dict[str, Any], dict[str, Any] | None]:
    chapter_order, section_order = parse_selector(selector)
    chapters = data["book"]["chapters"]
    if chapter_order > len(chapters):
        fail(f"Chapter {chapter_order} does not exist.")
    chapter = chapters[chapter_order - 1]
    if section_order is None:
        return chapter, None
    if section_order > len(chapter["sections"]):
        fail(f"Section {chapter_order}.{section_order} does not exist.")
    return chapter, chapter["sections"][section_order - 1]


def select_chapter(data: dict[str, Any], selector: str) -> dict[str, Any]:
    chapter, section = select_item(data, selector)
    if section is not None:
        fail(f"{selector} identifies a section; enter a chapter number.")
    return chapter


def tex_escape(value: str) -> str:
    replacements = {
        "\\": r"\textbackslash{}",
        "&": r"\&",
        "%": r"\%",
        "#": r"\#",
        "_": r"\_",
        "$": r"\$",
        "{": r"\{",
        "}": r"\}",
        "~": r"\textasciitilde{}",
        "^": r"\textasciicircum{}",
    }
    return "".join(replacements.get(character, character) for character in value)


def relative(path: Path) -> str:
    try:
        return path.resolve().relative_to(ROOT.resolve()).as_posix()
    except ValueError:
        fail(f"Path is outside the note repository: {path}")


def safe_chapter_path(*parts: str) -> Path:
    path = CHAPTERS_DIR.joinpath(*parts)
    resolved = path.resolve()
    try:
        resolved.relative_to(CHAPTERS_DIR.resolve())
    except ValueError:
        fail(f"Refusing an operation outside the chapters directory: {path}")
    return path


def atomic_write(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    mode = path.stat().st_mode if path.exists() else None
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.", dir=path.parent
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="") as handle:
            handle.write(content)
        if mode is not None:
            os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        if temporary.exists():
            temporary.unlink()


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except UnicodeDecodeError as error:
        fail(f"File is not valid UTF-8: {relative(path)} ({error})")


def load_manifest() -> dict[str, Any]:
    if not MANIFEST.is_file():
        fail(f"Manifest not found: {MANIFEST}")
    try:
        data = json.loads(read_text(MANIFEST))
    except json.JSONDecodeError as error:
        fail(f"Invalid JSON in {MANIFEST_NAME}: {error}")
    validate_manifest(data)
    return data


def manifest_text(data: dict[str, Any]) -> str:
    return json.dumps(data, ensure_ascii=False, indent=2) + "\n"


def chapter_tex(chapter_id: str) -> str:
    return f"chapters/{chapter_id}/{chapter_id}.tex"


def chapter_url(chapter_id: str) -> str:
    return f"pdf/chapters/{chapter_id}/{chapter_id}.pdf"


def section_tex(chapter_id: str, section_id: str) -> str:
    return f"chapters/{chapter_id}/{section_id}/{section_id}.tex"


def section_url(chapter_id: str, section_id: str) -> str:
    return f"pdf/chapters/{chapter_id}/{section_id}/{section_id}.pdf"


def normalize(data: dict[str, Any]) -> None:
    for chapter_order, chapter in enumerate(data["book"]["chapters"], start=1):
        chapter["order"] = chapter_order
        chapter["tex"] = chapter_tex(chapter["id"])
        chapter["url"] = chapter_url(chapter["id"])
        for section_order, section in enumerate(chapter["sections"], start=1):
            section["order"] = section_order
            section["tex"] = section_tex(chapter["id"], section["id"])
            section["url"] = section_url(chapter["id"], section["id"])


def validate_manifest(data: Any) -> None:
    if not isinstance(data, dict):
        fail("The manifest root must be a JSON object.")
    if data.get("schemaVersion") != 2:
        fail("The manifest schemaVersion must be 2.")
    build = data.get("build")
    if not isinstance(build, dict) or build.get("engine") != "xelatex":
        fail("The manifest build engine must be xelatex.")
    book = data.get("book")
    if not isinstance(book, dict):
        fail("The manifest must contain a book object.")

    book_id = require_slug_value(book.get("id"), "book.id")
    require_title_value(book.get("title"), "book.title")
    require_status_value(book.get("status"), "book.status")
    if book.get("tex") != f"{book_id}.tex":
        fail("book.tex does not match book.id.")
    if book.get("url") != f"pdf/{book_id}.pdf":
        fail("book.url does not match book.id.")

    chapters = book.get("chapters")
    if not isinstance(chapters, list):
        fail("book.chapters must be an array.")
    seen_chapters: set[str] = set()
    seen_tex = {book["tex"]}
    seen_urls = {book["url"]}
    for chapter_order, chapter in enumerate(chapters, start=1):
        if not isinstance(chapter, dict):
            fail(f"Chapter {chapter_order} must be an object.")
        chapter_id = require_slug_value(
            chapter.get("id"), f"chapter {chapter_order}.id"
        )
        if chapter_id in seen_chapters:
            fail(f"Duplicate chapter ID: {chapter_id}")
        seen_chapters.add(chapter_id)
        require_title_value(chapter.get("title"), f"chapter {chapter_id}.title")
        require_status_value(chapter.get("status"), f"chapter {chapter_id}.status")
        if chapter.get("order") != chapter_order:
            fail(f"Chapter order is not consecutive at {chapter_id}.")
        if chapter.get("tex") != chapter_tex(chapter_id):
            fail(f"Chapter TeX path does not match its ID: {chapter_id}")
        if chapter.get("url") != chapter_url(chapter_id):
            fail(f"Chapter PDF URL does not match its ID: {chapter_id}")
        check_unique(chapter["tex"], seen_tex, "TeX path")
        check_unique(chapter["url"], seen_urls, "PDF URL")

        sections = chapter.get("sections")
        if not isinstance(sections, list):
            fail(f"sections must be an array for chapter {chapter_id}.")
        seen_sections: set[str] = set()
        for section_order, section in enumerate(sections, start=1):
            if not isinstance(section, dict):
                fail(f"Section {chapter_id}/{section_order} must be an object.")
            section_id = require_slug_value(
                section.get("id"), f"section {chapter_id}/{section_order}.id"
            )
            if section_id in seen_sections:
                fail(f"Duplicate section ID in {chapter_id}: {section_id}")
            seen_sections.add(section_id)
            require_title_value(
                section.get("title"), f"section {chapter_id}/{section_id}.title"
            )
            require_status_value(
                section.get("status"), f"section {chapter_id}/{section_id}.status"
            )
            if section.get("order") != section_order:
                fail(
                    f"Section order is not consecutive at "
                    f"{chapter_id}/{section_id}."
                )
            if section.get("tex") != section_tex(chapter_id, section_id):
                fail(
                    f"Section TeX path does not match its IDs: "
                    f"{chapter_id}/{section_id}"
                )
            if section.get("url") != section_url(chapter_id, section_id):
                fail(
                    f"Section PDF URL does not match its IDs: "
                    f"{chapter_id}/{section_id}"
                )
            check_unique(section["tex"], seen_tex, "TeX path")
            check_unique(section["url"], seen_urls, "PDF URL")


def require_slug_value(value: Any, field: str) -> str:
    if not isinstance(value, str) or not SLUG_RE.fullmatch(value):
        fail(f"{field} must be a lowercase hyphenated slug.")
    return value


def require_title_value(value: Any, field: str) -> str:
    if (
        not isinstance(value, str)
        or not value
        or any(character in value for character in "\t\r\n")
    ):
        fail(f"{field} must be a nonempty one-line string.")
    return value


def require_status_value(value: Any, field: str) -> str:
    if value not in STATUSES:
        fail(
            f"{field} must be finished-published, draft-published, "
            "or draft-unpublished."
        )
    return value


def check_unique(value: str, seen: set[str], description: str) -> None:
    if value in seen:
        fail(f"Duplicate {description}: {value}")
    seen.add(value)


def replace_managed_block(content: str, name: str, body: list[str]) -> str:
    begin_text = f"% manage-notes:begin {name}"
    end_text = f"% manage-notes:end {name}"
    lines = content.splitlines()
    begin = [index for index, line in enumerate(lines) if line.strip() == begin_text]
    end = [index for index, line in enumerate(lines) if line.strip() == end_text]
    if len(begin) != 1 or len(end) != 1 or begin[0] >= end[0]:
        fail(f"Expected exactly one valid managed {name} block.")
    updated = lines[: begin[0] + 1] + body + lines[end[0] :]
    return "\n".join(updated) + ("\n" if content.endswith("\n") else "")


def set_first_line(content: str, expected: str) -> str:
    lines = content.splitlines()
    if not lines:
        return expected + "\n"
    if lines[0].startswith("% !TeX "):
        lines[0] = expected
    else:
        lines.insert(0, expected)
    return "\n".join(lines) + ("\n" if content.endswith("\n") else "")


def set_title(content: str, title: str) -> str:
    escaped = tex_escape(title)
    if len(TITLE_RE.findall(content)) != 1:
        fail("Expected exactly one one-line \\title{...} command.")
    return TITLE_RE.sub(lambda _: rf"\title{{{escaped}}}", content, count=1)


def watermark_package_line(status: str) -> str:
    require_status(status)
    return (
        r"\usepackage{draftwatermark}"
        if status.startswith("draft-")
        else r"% \usepackage{draftwatermark}"
    )


def set_watermark(content: str, status: str) -> str:
    package_line = watermark_package_line(status)
    begin_text = "% manage-notes:begin watermark"
    end_text = "% manage-notes:end watermark"
    lines = content.splitlines()
    has_begin = any(line.strip() == begin_text for line in lines)
    has_end = any(line.strip() == end_text for line in lines)
    if has_begin or has_end:
        return replace_managed_block(content, "watermark", [package_line])

    matches = [
        index for index, line in enumerate(lines) if WATERMARK_RE.fullmatch(line)
    ]
    if len(matches) != 1:
        fail("Expected exactly one draftwatermark package line.")
    index = matches[0]
    updated = (
        lines[:index]
        + [begin_text, package_line, end_text]
        + lines[index + 1 :]
    )
    return "\n".join(updated) + ("\n" if content.endswith("\n") else "")


def render_book(data: dict[str, Any]) -> list[str]:
    lines: list[str] = []
    for chapter_index, chapter in enumerate(data["book"]["chapters"]):
        title = tex_escape(chapter["title"])
        lines.append(rf"    \chapter{{{title}}}")
        for section in chapter["sections"]:
            section_title = tex_escape(section["title"])
            body_path = f"chapters/{chapter['id']}/{section['id']}/text.tex"
            lines.append(rf"        \section{{{section_title}}}")
            lines.append(rf"        \input{{{body_path}}}")
        if chapter_index != len(data["book"]["chapters"]) - 1:
            lines.append("")
    return lines


def render_chapter(chapter: dict[str, Any]) -> list[str]:
    lines: list[str] = []
    for section in chapter["sections"]:
        title = tex_escape(section["title"])
        lines.append(rf"    \section{{{title}}}")
        lines.append(rf"    \input{{{section['id']}/text.tex}}")
    return lines


def render_section(section: dict[str, Any]) -> list[str]:
    return [rf"    \section{{{tex_escape(section['title'])}}}"]


def prepared_updates(data: dict[str, Any]) -> dict[Path, str]:
    updates: dict[Path, str] = {}
    book = data["book"]
    book_path = ROOT / book["tex"]
    if not book_path.is_file():
        fail(f"Book TeX file is missing: {book['tex']}")
    content = read_text(book_path)
    try:
        content = replace_managed_block(content, "chapters", render_book(data))
        content = set_first_line(content, ENGINE_HEAD)
        content = set_title(content, book["title"])
        content = set_watermark(content, book["status"])
    except ManageNotesError as error:
        fail(f"{book['tex']}: {error}")
    updates[book_path] = content

    for chapter in book["chapters"]:
        chapter_path = ROOT / chapter["tex"]
        if chapter_path.is_file():
            content = read_text(chapter_path)
            try:
                content = replace_managed_block(
                    content, "sections", render_chapter(chapter)
                )
                content = set_first_line(content, ENGINE_HEAD)
                content = set_title(content, chapter["title"])
                content = set_watermark(content, chapter["status"])
            except ManageNotesError as error:
                fail(f"{chapter['tex']}: {error}")
            updates[chapter_path] = content
            chapter_appendix = chapter_path.parent / "appendix.tex"
            update_existing_root_head(
                updates,
                chapter_appendix,
                f"% !TeX root = {chapter['id']}.tex",
            )

        for section in chapter["sections"]:
            section_path = ROOT / section["tex"]
            if section_path.is_file():
                content = read_text(section_path)
                try:
                    content = replace_managed_block(
                        content, "section", render_section(section)
                    )
                    content = set_first_line(content, ENGINE_HEAD)
                    content = set_title(content, section["title"])
                    content = set_watermark(content, section["status"])
                except ManageNotesError as error:
                    fail(f"{section['tex']}: {error}")
                updates[section_path] = content

            body_path = safe_chapter_path(chapter["id"], section["id"], "text.tex")
            if body_path.is_file():
                body = set_first_line(
                    read_text(body_path), f"% !TeX root = {section['id']}.tex"
                )
                updates[body_path] = body
            section_appendix = body_path.parent / "appendix.tex"
            update_existing_root_head(
                updates,
                section_appendix,
                f"% !TeX root = {section['id']}.tex",
            )
    return updates


def update_existing_root_head(
    updates: dict[Path, str], path: Path, expected: str
) -> None:
    """Update an opt-in root head without adding heads to existing appendices."""
    if not path.is_file():
        return
    content = read_text(path)
    if content.startswith("% !TeX root = "):
        updates[path] = set_first_line(content, expected)


def changed_updates(updates: dict[Path, str]) -> dict[Path, str]:
    return {
        path: content
        for path, content in updates.items()
        if not path.exists() or read_text(path) != content
    }


def save_and_sync(
    data: dict[str, Any],
    *,
    dry_run: bool,
    description: str,
) -> None:
    normalize(data)
    validate_manifest(data)
    updates = prepared_updates(data)
    changes = changed_updates(updates)
    manifest_changed = manifest_text(data) != read_text(MANIFEST)
    if dry_run:
        print(f"Would {description}.")
        if manifest_changed:
            print(f"Would update {MANIFEST_NAME}.")
        for path in changes:
            print(f"Would synchronize {relative(path)}.")
        return

    atomic_write(MANIFEST, manifest_text(data))
    for path, content in changes.items():
        atomic_write(path, content)
    print(f"{description[:1].upper()}{description[1:]}.")


def synchronize(data: dict[str, Any], dry_run: bool) -> None:
    normalize(data)
    validate_manifest(data)
    updates = changed_updates(prepared_updates(data))
    normalized_manifest = manifest_text(data)
    manifest_changed = normalized_manifest != read_text(MANIFEST)
    if dry_run:
        if not manifest_changed and not updates:
            print("No synchronization changes are needed.")
            return
        if manifest_changed:
            print(f"Would normalize {MANIFEST_NAME}.")
        for path in updates:
            print(f"Would synchronize {relative(path)}.")
        return
    if manifest_changed:
        atomic_write(MANIFEST, normalized_manifest)
    for path, content in updates.items():
        atomic_write(path, content)
    if manifest_changed or updates:
        print(f"Synchronized {MANIFEST_NAME} and managed TeX files.")
    else:
        print("No synchronization changes were needed.")


def chapter_template(chapter_id: str, title: str, status: str) -> str:
    escaped = tex_escape(title)
    watermark = watermark_package_line(status)
    return rf"""% !TeX program = xelatex
% !TeX encoding = UTF-8
% !BIB program = biber
\documentclass[sectionlevel=chapter]{{noteformyself}}
% manage-notes:begin watermark
{watermark}
% manage-notes:end watermark

\input{{../../accessories/notation.tex}}
\addbibresource{{../../accessories/ref.bib}}
\newcommand{{\Yang}}[1]{{\textcolor{{red}}{{Yang: #1}}}}

\title{{{escaped}}}
\author{{Tianle Yang}}
\date{{\today}}
\authorpage{{\href{{https://www.tianleyang.com}}{{My Homepage}}}}

\setCJKfamilyfont{{lxgwwenkai}}{{LXGW WenKai}}
\coversentence{{\CJKfamily{{lxgwwenkai}}阿巴阿巴!}}
\coverimage{{}}
\covertitlefont{{TeX Gyre Termes}}

\begin{{document}}

    \maketitle

    \tableofcontents

    % manage-notes:begin sections
    % manage-notes:end sections

    \printbibliography[heading=bibintoc, title={{References}}]

\end{{document}}
"""


def section_template(section_id: str, title: str, status: str) -> str:
    escaped = tex_escape(title)
    watermark = watermark_package_line(status)
    return rf"""% !TeX program = xelatex
% !TeX encoding = UTF-8
% !BIB program = biber
\documentclass{{noteformyself}}
% manage-notes:begin watermark
{watermark}
% manage-notes:end watermark

\newcommand{{\Yang}}[1]{{\textcolor{{red}}{{Yang: #1}}}}
\input{{../../../accessories/notation.tex}}
\addbibresource{{../../../accessories/ref.bib}}

\title{{{escaped}}}
\author{{Tianle Yang}}
\date{{\today}}
\authorpage{{\href{{https://www.tianleyang.com}}{{My Homepage}}}}

\begin{{document}}

    \maketitle

    % manage-notes:begin section
    \section{{{escaped}}}
    % manage-notes:end section

    \input{{text.tex}}

    \input{{appendix.tex}}

    % \printbibliography[heading=bibintoc, title={{References}}]

\end{{document}}
"""


def create_file(path: Path, content: str, dry_run: bool) -> None:
    if path.exists():
        fail(f"Refusing to overwrite an existing path: {relative(path)}")
    if dry_run:
        return
    atomic_write(path, content)


def ensure_chapter_files(
    chapter: dict[str, Any], dry_run: bool, *, new_only: bool = False
) -> None:
    directory = safe_chapter_path(chapter["id"])
    wrapper = directory / f"{chapter['id']}.tex"
    appendix = directory / "appendix.tex"
    if new_only:
        create_file(
            wrapper,
            chapter_template(chapter["id"], chapter["title"], chapter["status"]),
            dry_run,
        )
        create_file(
            appendix,
            f"% !TeX root = {chapter['id']}.tex\n",
            dry_run,
        )
        return
    if not wrapper.exists():
        create_file(
            wrapper,
            chapter_template(chapter["id"], chapter["title"], chapter["status"]),
            dry_run,
        )
    if not appendix.exists():
        create_file(
            appendix,
            f"% !TeX root = {chapter['id']}.tex\n",
            dry_run,
        )


def ensure_section_files(
    chapter: dict[str, Any],
    section: dict[str, Any],
    dry_run: bool,
    *,
    new_only: bool = False,
) -> None:
    directory = safe_chapter_path(chapter["id"], section["id"])
    wrapper = directory / f"{section['id']}.tex"
    body = directory / "text.tex"
    appendix = directory / "appendix.tex"
    files = (
        (
            wrapper,
            section_template(
                section["id"], section["title"], section["status"]
            ),
        ),
        (body, f"% !TeX root = {section['id']}.tex\n"),
        (appendix, f"% !TeX root = {section['id']}.tex\n"),
    )
    for path, content in files:
        if new_only or not path.exists():
            create_file(path, content, dry_run)


def create_chapter(args: argparse.Namespace) -> None:
    data = load_manifest()
    title = require_title(args.title)
    status = require_status(args.status)
    chapters = data["book"]["chapters"]
    chapter_id = unique_slug(title, {chapter["id"] for chapter in chapters})
    order = require_order(
        args.order if args.order is not None else len(chapters) + 1,
        len(chapters) + 1,
    )
    directory = safe_chapter_path(chapter_id)
    if directory.exists():
        fail(f"Chapter directory already exists: {relative(directory)}")
    chapter = {
        "id": chapter_id,
        "title": title,
        "order": order,
        "tex": chapter_tex(chapter_id),
        "url": chapter_url(chapter_id),
        "status": status,
        "sections": [],
    }
    chapters.insert(order - 1, chapter)
    ensure_chapter_files(chapter, args.dry_run, new_only=True)
    save_and_sync(
        data,
        dry_run=args.dry_run,
        description=f"create chapter {order}: {title}",
    )


def create_section(args: argparse.Namespace) -> None:
    data = load_manifest()
    chapter = select_chapter(data, args.chapter)
    title = require_title(args.title)
    status = require_status(args.status)
    sections = chapter["sections"]
    section_id = unique_slug(title, {section["id"] for section in sections})
    order = require_order(
        args.order if args.order is not None else len(sections) + 1,
        len(sections) + 1,
    )
    directory = safe_chapter_path(chapter["id"], section_id)
    if directory.exists():
        fail(f"Section directory already exists: {relative(directory)}")
    section = {
        "id": section_id,
        "title": title,
        "order": order,
        "tex": section_tex(chapter["id"], section_id),
        "url": section_url(chapter["id"], section_id),
        "status": status,
    }
    sections.insert(order - 1, section)
    ensure_section_files(chapter, section, args.dry_run, new_only=True)
    save_and_sync(
        data,
        dry_run=args.dry_run,
        description=(
            f"create section {chapter['order']}.{order}: {title}"
        ),
    )


def git_target_dirty(path: Path) -> bool:
    result = subprocess.run(
        [
            "git",
            "-C",
            str(ROOT),
            "status",
            "--porcelain",
            "--untracked-files=all",
            "--",
            relative(path),
        ],
        check=False,
        capture_output=True,
        text=True,
    )
    return result.returncode == 0 and bool(result.stdout.strip())


def confirm_delete(selector: str, args: argparse.Namespace) -> None:
    if args.dry_run or args.yes:
        return
    expected = f"DELETE {selector}"
    response = input(f"Type '{expected}' to confirm: ")
    if response != expected:
        fail("Deletion cancelled.")


def delete_item(args: argparse.Namespace) -> None:
    data = load_manifest()
    chapter, section = select_item(data, args.item)
    if section is None:
        if chapter["sections"] and not args.recursive:
            fail("The chapter contains sections; pass --recursive to delete it.")
        directory = safe_chapter_path(chapter["id"])
        description = f"delete chapter {args.item}: {chapter['title']}"
    else:
        directory = safe_chapter_path(chapter["id"], section["id"])
        description = f"delete section {args.item}: {section['title']}"
    if directory.exists() and git_target_dirty(directory):
        fail(
            f"Refusing to delete modified or untracked files in {relative(directory)}."
        )
    confirm_delete(args.item, args)
    if section is None:
        del data["book"]["chapters"][chapter["order"] - 1]
    else:
        del chapter["sections"][section["order"] - 1]
    if not args.dry_run and directory.exists():
        shutil.rmtree(directory)
    save_and_sync(data, dry_run=args.dry_run, description=description)


def rename_item(args: argparse.Namespace) -> None:
    data = load_manifest()
    chapter, section = select_item(data, args.item)
    new_id = slugify(args.name)
    if section is None:
        old_id = chapter["id"]
        if new_id == old_id:
            fail(f"Chapter {args.item} already uses the name {new_id}.")
        if any(item["id"] == new_id for item in data["book"]["chapters"]):
            fail(f"Another chapter already uses the name {new_id}.")
        old_directory = safe_chapter_path(old_id)
        new_directory = safe_chapter_path(new_id)
        kind = "chapter"
    else:
        old_id = section["id"]
        if new_id == old_id:
            fail(f"Section {args.item} already uses the name {new_id}.")
        if any(item["id"] == new_id for item in chapter["sections"]):
            fail(f"Another section in chapter {chapter['order']} uses {new_id}.")
        old_directory = safe_chapter_path(chapter["id"], old_id)
        new_directory = safe_chapter_path(chapter["id"], new_id)
        kind = "section"
    if new_directory.exists():
        fail(f"Destination already exists: {relative(new_directory)}")
    if not args.dry_run:
        if not old_directory.is_dir():
            fail(f"{kind.capitalize()} directory is missing: {relative(old_directory)}")
        old_directory.rename(new_directory)
        old_wrapper = new_directory / f"{old_id}.tex"
        if old_wrapper.exists():
            old_wrapper.rename(new_directory / f"{new_id}.tex")
    if section is None:
        chapter["id"] = new_id
    else:
        section["id"] = new_id
    normalize(data)
    save_and_sync(
        data,
        dry_run=args.dry_run,
        description=f"rename {kind} {args.item} from {old_id} to {new_id}",
    )


def move_item(args: argparse.Namespace) -> None:
    data = load_manifest()
    source_chapter, source_section = select_item(data, args.item)
    destination_chapter_order, destination_section_order = parse_selector(
        args.destination
    )
    chapters = data["book"]["chapters"]
    if source_section is None:
        if destination_section_order is not None:
            fail("Move a chapter to a chapter order such as 4.")
        new_order = require_order(destination_chapter_order, len(chapters))
        chapter = chapters.pop(source_chapter["order"] - 1)
        chapters.insert(new_order - 1, chapter)
        description = f"move chapter {args.item} to order {new_order}"
    else:
        if destination_section_order is None:
            fail("Move a section to a position such as 4.2.")
        if destination_chapter_order > len(chapters):
            fail(f"Chapter {destination_chapter_order} does not exist.")
        destination = chapters[destination_chapter_order - 1]
        section = source_chapter["sections"].pop(source_section["order"] - 1)
        new_order = require_order(
            destination_section_order, len(destination["sections"]) + 1
        )
        if source_chapter is not destination and any(
            item["id"] == section["id"] for item in destination["sections"]
        ):
            fail(
                f"Chapter {destination_chapter_order} already contains a section "
                f"named {section['id']}."
            )
        old_directory = safe_chapter_path(source_chapter["id"], section["id"])
        new_directory = safe_chapter_path(destination["id"], section["id"])
        if source_chapter is not destination and new_directory.exists():
            fail(f"Destination already exists: {relative(new_directory)}")
        destination["sections"].insert(new_order - 1, section)
        if not args.dry_run and source_chapter is not destination:
            new_directory.parent.mkdir(parents=True, exist_ok=True)
            old_directory.rename(new_directory)
        description = (
            f"move section {args.item} to "
            f"{destination_chapter_order}.{new_order}"
        )

    normalize(data)
    save_and_sync(
        data,
        dry_run=args.dry_run,
        description=description,
    )


def retitle_item(args: argparse.Namespace) -> None:
    data = load_manifest()
    title = require_title(args.title)
    if args.item == "0":
        data["book"]["title"] = title
        kind = "book"
    else:
        chapter, section = select_item(data, args.item)
        target = section if section is not None else chapter
        target["title"] = title
        kind = "section" if section is not None else "chapter"
    save_and_sync(
        data,
        dry_run=args.dry_run,
        description=f"retitle {kind} {args.item} as {title}",
    )


def set_item_status(args: argparse.Namespace) -> None:
    data = load_manifest()
    status = require_status(args.status)
    if args.item == "0":
        data["book"]["status"] = status
        kind = "book"
    else:
        chapter, section = select_item(data, args.item)
        target = section if section is not None else chapter
        target["status"] = status
        kind = "section" if section is not None else "chapter"
    save_and_sync(
        data,
        dry_run=args.dry_run,
        description=f"set {kind} {args.item} status to {status}",
    )


def list_notes(data: dict[str, Any]) -> None:
    book = data["book"]
    print(f"\n0. {book['title']} [{book['status']}]\n")
    for chapter in book["chapters"]:
        print(
            f"{chapter['order']}. {chapter['title']} [{chapter['status']}]"
        )
        for section in chapter["sections"]:
            print(
                f"   {chapter['order']}.{section['order']} "
                f"{section['title']} [{section['status']}]"
            )


def validate_source_tree(data: dict[str, Any]) -> None:
    book = data["book"]
    listed_wrappers = {book["tex"]}
    required_wrappers = {book["tex"]}

    for chapter in book["chapters"]:
        listed_wrappers.add(chapter["tex"])
        required_wrappers.add(chapter["tex"])
        for section in chapter["sections"]:
            listed_wrappers.add(section["tex"])
            required_wrappers.add(section["tex"])

            body = safe_chapter_path(chapter["id"], section["id"], "text.tex")
            if not body.is_file():
                fail(f"Required section body is missing: {relative(body)}")
            content = read_text(body)
            expected_head = f"% !TeX root = {section['id']}.tex"
            if not content.startswith(expected_head + "\n"):
                fail(f"Incorrect or missing TeX root head: {relative(body)}")
            if SECTION_IN_BODY_RE.search(content):
                fail(
                    f"Section bodies must not contain a top-level "
                    f"\\section command: {relative(body)}"
                )

    for wrapper in required_wrappers:
        path = ROOT / wrapper
        if not path.is_file():
            fail(f"Required compilable TeX file is missing: {wrapper}")

    compilable: set[str] = set()
    for path in ROOT.rglob("*.tex"):
        relative_path = path.relative_to(ROOT)
        if any(part in {".git", "accessories"} for part in relative_path.parts):
            continue
        content = read_text(path)
        if DOCUMENTCLASS_RE.search(content):
            name = relative_path.as_posix()
            compilable.add(name)
            if not content.startswith(ENGINE_HEAD + "\n"):
                fail(f"Incorrect or missing compile-engine head: {name}")
    unexpected = sorted(compilable - listed_wrappers)
    if unexpected:
        fail(
            "Compilable TeX files missing from the manifest: "
            + ", ".join(unexpected)
        )

    updates = changed_updates(prepared_updates(data))
    if updates:
        fail(
            "Managed TeX files are not synchronized: "
            + ", ".join(relative(path) for path in updates)
            + ". Run manage-notes sync."
        )


def validate_command(data: dict[str, Any]) -> None:
    validate_manifest(data)
    validate_source_tree(data)
    print(f"{MANIFEST_NAME} and all managed TeX files are valid and synchronized.")


def add_global_arguments(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="show changes without writing them",
    )
    parser.add_argument(
        "--yes",
        action="store_true",
        help="skip exact deletion confirmation",
    )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="manage-notes",
        description=(
            "Manage chapters, sections, notes.json, and generated TeX inputs."
        ),
    )
    add_global_arguments(parser)
    subparsers = parser.add_subparsers(dest="command")

    subparsers.add_parser("list", help="show the ordered note tree")
    subparsers.add_parser("validate", help="validate the manifest and source tree")
    subparsers.add_parser("sync", help="regenerate managed TeX regions")

    create = subparsers.add_parser("create", help="create a chapter or section")
    create_types = create.add_subparsers(dest="kind", required=True)
    create_ch = create_types.add_parser("chapter")
    create_ch.add_argument("title")
    create_ch.add_argument(
        "status", nargs="?", default="draft-unpublished", choices=STATUSES
    )
    create_ch.add_argument("order", nargs="?", type=int)
    create_sec = create_types.add_parser("section")
    create_sec.add_argument("chapter", help="parent chapter order, such as 2")
    create_sec.add_argument("title")
    create_sec.add_argument(
        "status", nargs="?", default="draft-unpublished", choices=STATUSES
    )
    create_sec.add_argument("order", nargs="?", type=int)

    delete = subparsers.add_parser("delete", help="delete a chapter or section")
    delete.add_argument("item", help="chapter or section order, such as 2 or 2.3")
    delete.add_argument("--recursive", action="store_true")

    rename = subparsers.add_parser("rename", help="rename an ID and its paths")
    rename.add_argument("item", help="chapter or section order")
    rename.add_argument("name", help="new machine-readable name")

    move = subparsers.add_parser("move", help="reorder or reparent an item")
    move.add_argument("item", help="chapter or section order")
    move.add_argument(
        "destination",
        help="new chapter order or section position, such as 4 or 4.2",
    )

    retitle = subparsers.add_parser("retitle", help="change a human-readable title")
    retitle.add_argument("item", help="0 for the book, or a chapter/section order")
    retitle.add_argument("title")

    status = subparsers.add_parser("set-status", help="change publication status")
    status.add_argument("item", help="0 for the book, or a chapter/section order")
    status.add_argument("status", choices=STATUSES)
    return parser



def prompt_required(label: str) -> str:
    value = input(f"{label}: ").strip()
    if not value:
        fail(f"{label} may not be empty.")
    return value


def prompt_optional_order() -> int | None:
    value = input("Order [last]: ").strip()
    if not value:
        return None
    if not value.isdigit():
        fail("Order must be a positive integer.")
    return int(value)


def prompt_status(default: str = "draft-unpublished") -> str:
    print(
        "  1) finished-published\n"
        "  2) draft-published\n"
        "  3) draft-unpublished"
    )
    value = input(f"Status [{default}]: ").strip()
    choices = {
        "": default,
        "1": "finished-published",
        "2": "draft-published",
        "3": "draft-unpublished",
    }
    return require_status(choices.get(value, value))


def interactive_namespace(
    global_args: argparse.Namespace, **values: Any
) -> argparse.Namespace:
    return argparse.Namespace(
        dry_run=global_args.dry_run,
        yes=global_args.yes,
        **values,
    )


def interactive_loop(global_args: argparse.Namespace) -> None:
    list_notes(load_manifest())
    menu = (
        "\n[a] List       [b] Create      [c] Delete\n"
        "[d] Rename     [e] Retitle     [f] Move\n"
        "[g] Set status                 [q] Quit\n"
    )
    while True:
        print(menu)
        try:
            choice = input("Choice: ").strip().lower()
            if choice == "q":
                return
            if choice == "a":
                list_notes(load_manifest())
                continue
            if choice == "b":
                kind = input("Create [c]hapter or [s]ection: ").strip().lower()
                if kind not in {"c", "s"}:
                    fail("Choose c for chapter or s for section.")
                if kind == "c":
                    args = interactive_namespace(
                        global_args,
                        title=prompt_required("Title"),
                        status=prompt_status(),
                        order=prompt_optional_order(),
                    )
                    create_chapter(args)
                else:
                    args = interactive_namespace(
                        global_args,
                        chapter=prompt_required("Parent chapter number"),
                        title=prompt_required("Title"),
                        status=prompt_status(),
                        order=prompt_optional_order(),
                    )
                    create_section(args)
            elif choice == "c":
                item = prompt_required("Item number (for example 2 or 2.3)")
                chapter, section = select_item(load_manifest(), item)
                recursive = False
                if section is None and chapter["sections"]:
                    recursive = (
                        input("Delete the chapter and all its sections? [y/N]: ")
                        .strip()
                        .lower()
                        in {"y", "yes"}
                    )
                delete_item(
                    interactive_namespace(
                        global_args,
                        item=item,
                        recursive=recursive,
                    )
                )
            elif choice == "d":
                rename_item(
                    interactive_namespace(
                        global_args,
                        item=prompt_required(
                            "Item number (for example 2 or 2.3)"
                        ),
                        name=prompt_required("New file/folder name"),
                    )
                )
            elif choice == "e":
                retitle_item(
                    interactive_namespace(
                        global_args,
                        item=prompt_required(
                            "Item number (0 for book, or for example 2 or 2.3)"
                        ),
                        title=prompt_required("New title"),
                    )
                )
            elif choice == "f":
                move_item(
                    interactive_namespace(
                        global_args,
                        item=prompt_required(
                            "Item number (for example 2 or 2.3)"
                        ),
                        destination=prompt_required(
                            "New position (for example 4 or 4.2)"
                        ),
                    )
                )
            elif choice == "g":
                set_item_status(
                    interactive_namespace(
                        global_args,
                        item=prompt_required(
                            "Item number (0 for book, or for example 2 or 2.3)"
                        ),
                        status=prompt_status(),
                    )
                )
            else:
                fail("Choose a, b, c, d, e, f, g, or q.")
            list_notes(load_manifest())
        except ManageNotesError as error:
            print(f"Error: {error}", file=sys.stderr)
        except (EOFError, KeyboardInterrupt):
            print()
            return


def dispatch(args: argparse.Namespace) -> None:
    if args.command == "list":
        list_notes(load_manifest())
    elif args.command == "validate":
        validate_command(load_manifest())
    elif args.command == "sync":
        synchronize(load_manifest(), args.dry_run)
    elif args.command == "create" and args.kind == "chapter":
        create_chapter(args)
    elif args.command == "create" and args.kind == "section":
        create_section(args)
    elif args.command == "delete":
        delete_item(args)
    elif args.command == "rename":
        rename_item(args)
    elif args.command == "move":
        move_item(args)
    elif args.command == "retitle":
        retitle_item(args)
    elif args.command == "set-status":
        set_item_status(args)
    else:
        fail("No command was selected.")


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    if args.command is None:
        interactive_loop(args)
    else:
        dispatch(args)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except ManageNotesError as error:
        print(f"Error: {error}", file=sys.stderr)
        raise SystemExit(1)
