#!/usr/bin/env python3
"""Manage the chapters, sections, and public build manifest of this LaTeX note."""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import unicodedata
from pathlib import Path
from typing import Literal, NoReturn, TypedDict, cast


Binary = Literal[0, 1]
SLUG_RE = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
SECTION_IN_BODY_RE = re.compile(r"^\s*\\section(?:\[[^\]]*\])?\{", re.MULTILINE)
DOCUMENTCLASS_RE = re.compile(r"^\s*\\documentclass(?:\[|\{)", re.MULTILINE)
TITLE_RE = re.compile(r"^\\title\{.*\}$", re.MULTILINE)
WATERMARK_RE = re.compile(
    r"^\s*%?\s*\\usepackage\{draftwatermark\}(?:\s*%.*)?$"
)
ENGINE_HEAD = "% !TeX program = xelatex"


class StatusRecord(TypedDict):
    published: Binary
    finished: Binary


class SectionRecord(TypedDict):
    id: str
    title: str
    order: int
    tex: str
    url: str
    status: StatusRecord


class ChapterRecord(TypedDict):
    id: str
    title: str
    order: int
    tex: str
    url: str
    status: StatusRecord
    sections: list[SectionRecord]


class BookRecord(TypedDict):
    id: str
    title: str
    tex: str
    url: str
    status: StatusRecord
    chapters: list[ChapterRecord]


class BuildRecord(TypedDict):
    engine: str


class ManifestRecord(TypedDict):
    schemaVersion: int
    build: BuildRecord
    book: BookRecord


class ManageNotesError(RuntimeError):
    """An error that can be reported without a traceback."""


def find_repo_root() -> Path:
    configured = os.environ.get("MANAGE_NOTES_ROOT")
    if configured:
        root = Path(configured).expanduser().resolve()
        if not root.is_dir():
            raise ManageNotesError(f"Repository root does not exist: {root}")
        return root

    script_dir = Path(__file__).resolve().parent
    result = subprocess.run(
        ["git", "-C", str(script_dir), "rev-parse", "--show-superproject-working-tree"],
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode == 0 and result.stdout.strip():
        return Path(result.stdout.strip()).resolve()

    candidate = script_dir.parent
    if (candidate / ".git").exists():
        return candidate
    raise ManageNotesError(
        "Could not find the parent note repository. Set MANAGE_NOTES_ROOT."
    )


ROOT = find_repo_root()
MANIFEST_NAME = os.environ.get("MANAGE_NOTES_MANIFEST", "notes.json")
MANIFEST = ROOT / MANIFEST_NAME
CHAPTERS_DIR = ROOT / "chapters"


def fail(message: str) -> NoReturn:
    raise ManageNotesError(message)


def require_slug(value: str) -> str:
    if not SLUG_RE.fullmatch(value):
        fail("Slugs must use lowercase letters, numbers, and single hyphens.")
    return value


def require_title(value: str) -> str:
    if not value or any(character in value for character in "\t\r\n"):
        fail("Titles must be nonempty, fit on one line, and contain no tabs.")
    return value


def require_binary(value: object, field: str) -> Binary:
    if type(value) is not int or value not in (0, 1):
        fail(f"{field} must be 0 or 1.")
    return cast(Binary, value)


def binary_arg(value: str) -> Binary:
    try:
        parsed = int(value)
    except ValueError:
        fail("Status values must be 0 or 1.")
    return require_binary(parsed, "Status value")


def make_status(published: object, finished: object) -> StatusRecord:
    return {
        "published": require_binary(published, "published"),
        "finished": require_binary(finished, "finished"),
    }


def require_order(value: int, maximum: int) -> int:
    if value < 1 or value > maximum:
        fail(f"Order must be between 1 and {maximum}.")
    return value


def slugify(value: str) -> str:
    normalized = unicodedata.normalize("NFKD", require_title(value))
    ascii_value = normalized.encode("ascii", "ignore").decode("ascii").lower()
    slug = re.sub(r"[^a-z0-9]+", "-", ascii_value).strip("-")
    if not slug:
        fail("The title must contain letters or numbers for a generated filename.")
    return require_slug(slug)


def unique_slug(value: str, existing: set[str]) -> str:
    base = slugify(value)
    if base not in existing:
        return base
    suffix = 2
    while f"{base}-{suffix}" in existing:
        suffix += 1
    return f"{base}-{suffix}"


def parse_selector(value: str) -> tuple[int, int | None]:
    parts = value.strip().split(".")
    if (
        len(parts) not in (1, 2)
        or any(not part.isdigit() or part.startswith("0") for part in parts)
    ):
        fail("Use an order such as 2 for a chapter or 2.3 for a section.")
    chapter_order = int(parts[0])
    section_order = int(parts[1]) if len(parts) == 2 else None
    return chapter_order, section_order


def select_item(
    data: ManifestRecord, selector: str
) -> tuple[ChapterRecord, SectionRecord | None]:
    chapter_order, section_order = parse_selector(selector)
    chapters = data["book"]["chapters"]
    if chapter_order > len(chapters):
        fail(f"Chapter {chapter_order} does not exist.")
    chapter = chapters[chapter_order - 1]
    if section_order is None:
        return chapter, None
    if section_order > len(chapter["sections"]):
        fail(f"Section {chapter_order}.{section_order} does not exist.")
    return chapter, chapter["sections"][section_order - 1]


def select_chapter(data: ManifestRecord, selector: str) -> ChapterRecord:
    chapter, section = select_item(data, selector)
    if section is not None:
        fail(f"{selector} identifies a section; enter a chapter number.")
    return chapter


def tex_escape(value: str) -> str:
    replacements = {
        "\\": r"\textbackslash{}",
        "&": r"\&",
        "%": r"\%",
        "#": r"\#",
        "_": r"\_",
        "$": r"\$",
        "{": r"\{",
        "}": r"\}",
        "~": r"\textasciitilde{}",
        "^": r"\textasciicircum{}",
    }
    return "".join(replacements.get(character, character) for character in value)


def relative(path: Path) -> str:
    try:
        return path.resolve().relative_to(ROOT.resolve()).as_posix()
    except ValueError:
        fail(f"Path is outside the note repository: {path}")


def safe_chapter_path(*parts: str) -> Path:
    path = CHAPTERS_DIR.joinpath(*parts)
    resolved = path.resolve()
    try:
        resolved.relative_to(CHAPTERS_DIR.resolve())
    except ValueError:
        fail(f"Refusing an operation outside the chapters directory: {path}")
    return path


def atomic_write(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    mode = path.stat().st_mode if path.exists() else None
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.", dir=path.parent
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="") as handle:
            handle.write(content)
        if mode is not None:
            os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        if temporary.exists():
            temporary.unlink()


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except UnicodeDecodeError as error:
        fail(f"File is not valid UTF-8: {relative(path)} ({error})")


def load_manifest() -> ManifestRecord:
    if not MANIFEST.is_file():
        fail(f"Manifest not found: {MANIFEST}")
    try:
        data: object = json.loads(read_text(MANIFEST))
    except json.JSONDecodeError as error:
        fail(f"Invalid JSON in {MANIFEST_NAME}: {error}")
    validate_manifest(data)
    return cast(ManifestRecord, data)


def manifest_text(data: ManifestRecord) -> str:
    return json.dumps(data, ensure_ascii=False, indent=2) + "\n"


def chapter_tex(chapter_id: str) -> str:
    return f"chapters/{chapter_id}/{chapter_id}.tex"


def chapter_url(chapter_id: str) -> str:
    return f"pdf/chapters/{chapter_id}/{chapter_id}.pdf"


def section_tex(chapter_id: str, section_id: str) -> str:
    return f"chapters/{chapter_id}/{section_id}/{section_id}.tex"


def section_url(chapter_id: str, section_id: str) -> str:
    return f"pdf/chapters/{chapter_id}/{section_id}/{section_id}.pdf"


def normalize(data: ManifestRecord) -> None:
    for chapter_order, chapter in enumerate(data["book"]["chapters"], start=1):
        chapter["order"] = chapter_order
        chapter["tex"] = chapter_tex(chapter["id"])
        chapter["url"] = chapter_url(chapter["id"])
        for section_order, section in enumerate(chapter["sections"], start=1):
            section["order"] = section_order
            section["tex"] = section_tex(chapter["id"], section["id"])
            section["url"] = section_url(chapter["id"], section["id"])


def validate_manifest(data: object) -> None:
    if not isinstance(data, dict):
        fail("The manifest root must be a JSON object.")
    root = cast(dict[str, object], data)
    if root.get("schemaVersion") != 3:
        fail("The manifest schemaVersion must be 3.")
    build_value = root.get("build")
    if not isinstance(build_value, dict):
        fail("The manifest must contain a build object.")
    build = cast(dict[str, object], build_value)
    if build.get("engine") != "xelatex":
        fail("The manifest build engine must be xelatex.")
    book_value = root.get("book")
    if not isinstance(book_value, dict):
        fail("The manifest must contain a book object.")
    book = cast(dict[str, object], book_value)

    book_id = require_slug_value(book.get("id"), "book.id")
    require_title_value(book.get("title"), "book.title")
    require_status_value(book.get("status"), "book.status")
    if book.get("tex") != f"{book_id}.tex":
        fail("book.tex does not match book.id.")
    if book.get("url") != f"pdf/{book_id}.pdf":
        fail("book.url does not match book.id.")

    chapters_value = book.get("chapters")
    if not isinstance(chapters_value, list):
        fail("book.chapters must be an array.")
    chapters = cast(list[object], chapters_value)
    seen_chapters: set[str] = set()
    seen_tex = {cast(str, book["tex"])}
    seen_urls = {cast(str, book["url"])}
    for chapter_order, chapter_value in enumerate(chapters, start=1):
        if not isinstance(chapter_value, dict):
            fail(f"Chapter {chapter_order} must be an object.")
        chapter = cast(dict[str, object], chapter_value)
        chapter_id = require_slug_value(
            chapter.get("id"), f"chapter {chapter_order}.id"
        )
        if chapter_id in seen_chapters:
            fail(f"Duplicate chapter ID: {chapter_id}")
        seen_chapters.add(chapter_id)
        require_title_value(chapter.get("title"), f"chapter {chapter_id}.title")
        require_status_value(chapter.get("status"), f"chapter {chapter_id}.status")
        if chapter.get("order") != chapter_order:
            fail(f"Chapter order is not consecutive at {chapter_id}.")
        if chapter.get("tex") != chapter_tex(chapter_id):
            fail(f"Chapter TeX path does not match its ID: {chapter_id}")
        if chapter.get("url") != chapter_url(chapter_id):
            fail(f"Chapter PDF URL does not match its ID: {chapter_id}")
        check_unique(cast(str, chapter["tex"]), seen_tex, "TeX path")
        check_unique(cast(str, chapter["url"]), seen_urls, "PDF URL")

        sections_value = chapter.get("sections")
        if not isinstance(sections_value, list):
            fail(f"sections must be an array for chapter {chapter_id}.")
        sections = cast(list[object], sections_value)
        seen_sections: set[str] = set()
        for section_order, section_value in enumerate(sections, start=1):
            if not isinstance(section_value, dict):
                fail(f"Section {chapter_id}/{section_order} must be an object.")
            section = cast(dict[str, object], section_value)
            section_id = require_slug_value(
                section.get("id"), f"section {chapter_id}/{section_order}.id"
            )
            if section_id in seen_sections:
                fail(f"Duplicate section ID in {chapter_id}: {section_id}")
            seen_sections.add(section_id)
            require_title_value(
                section.get("title"), f"section {chapter_id}/{section_id}.title"
            )
            require_status_value(
                section.get("status"), f"section {chapter_id}/{section_id}.status"
            )
            if section.get("order") != section_order:
                fail(
                    f"Section order is not consecutive at "
                    f"{chapter_id}/{section_id}."
                )
            if section.get("tex") != section_tex(chapter_id, section_id):
                fail(
                    f"Section TeX path does not match its IDs: "
                    f"{chapter_id}/{section_id}"
                )
            if section.get("url") != section_url(chapter_id, section_id):
                fail(
                    f"Section PDF URL does not match its IDs: "
                    f"{chapter_id}/{section_id}"
                )
            check_unique(cast(str, section["tex"]), seen_tex, "TeX path")
            check_unique(cast(str, section["url"]), seen_urls, "PDF URL")


def require_slug_value(value: object, field: str) -> str:
    if not isinstance(value, str) or not SLUG_RE.fullmatch(value):
        fail(f"{field} must be a lowercase hyphenated slug.")
    return value


def require_title_value(value: object, field: str) -> str:
    if (
        not isinstance(value, str)
        or not value
        or any(character in value for character in "\t\r\n")
    ):
        fail(f"{field} must be a nonempty one-line string.")
    return value


def require_status_value(value: object, field: str) -> StatusRecord:
    if not isinstance(value, dict):
        fail(f"{field} must be an object with published and finished fields.")
    status = cast(dict[str, object], value)
    if set(status) != {"published", "finished"}:
        fail(f"{field} must contain exactly published and finished.")
    return make_status(status["published"], status["finished"])


def check_unique(value: str, seen: set[str], description: str) -> None:
    if value in seen:
        fail(f"Duplicate {description}: {value}")
    seen.add(value)


def replace_managed_block(content: str, name: str, body: list[str]) -> str:
    begin_text = f"% manage-notes:begin {name}"
    end_text = f"% manage-notes:end {name}"
    lines = content.splitlines()
    begin = [index for index, line in enumerate(lines) if line.strip() == begin_text]
    end = [index for index, line in enumerate(lines) if line.strip() == end_text]
    if len(begin) != 1 or len(end) != 1 or begin[0] >= end[0]:
        fail(f"Expected exactly one valid managed {name} block.")
    updated = lines[: begin[0] + 1] + body + lines[end[0] :]
    return "\n".join(updated) + ("\n" if content.endswith("\n") else "")


def set_first_line(content: str, expected: str) -> str:
    lines = content.splitlines()
    if not lines:
        return expected + "\n"
    if lines[0].startswith("% !TeX "):
        lines[0] = expected
    else:
        lines.insert(0, expected)
    return "\n".join(lines) + ("\n" if content.endswith("\n") else "")


def set_title(content: str, title: str) -> str:
    escaped = tex_escape(title)
    if len(TITLE_RE.findall(content)) != 1:
        fail("Expected exactly one one-line \\title{...} command.")
    return TITLE_RE.sub(lambda _: rf"\title{{{escaped}}}", content, count=1)


def watermark_package_line(status: StatusRecord) -> str:
    return (
        r"\usepackage{draftwatermark}"
        if status["finished"] == 0
        else r"% \usepackage{draftwatermark}"
    )


def set_watermark(content: str, status: StatusRecord) -> str:
    package_line = watermark_package_line(status)
    begin_text = "% manage-notes:begin watermark"
    end_text = "% manage-notes:end watermark"
    lines = content.splitlines()
    has_begin = any(line.strip() == begin_text for line in lines)
    has_end = any(line.strip() == end_text for line in lines)
    if has_begin or has_end:
        return replace_managed_block(content, "watermark", [package_line])

    matches = [
        index for index, line in enumerate(lines) if WATERMARK_RE.fullmatch(line)
    ]
    if len(matches) != 1:
        fail("Expected exactly one draftwatermark package line.")
    index = matches[0]
    updated = (
        lines[:index]
        + [begin_text, package_line, end_text]
        + lines[index + 1 :]
    )
    return "\n".join(updated) + ("\n" if content.endswith("\n") else "")


def render_book(data: ManifestRecord) -> list[str]:
    lines: list[str] = []
    for chapter_index, chapter in enumerate(data["book"]["chapters"]):
        title = tex_escape(chapter["title"])
        lines.append(rf"    \chapter{{{title}}}")
        for section in chapter["sections"]:
            section_title = tex_escape(section["title"])
            body_path = f"chapters/{chapter['id']}/{section['id']}/text.tex"
            lines.append(rf"        \section{{{section_title}}}")
            lines.append(rf"        \input{{{body_path}}}")
        if chapter_index != len(data["book"]["chapters"]) - 1:
            lines.append("")
    return lines


def render_chapter(chapter: ChapterRecord) -> list[str]:
    lines: list[str] = []
    for section in chapter["sections"]:
        title = tex_escape(section["title"])
        lines.append(rf"    \section{{{title}}}")
        lines.append(rf"    \input{{{section['id']}/text.tex}}")
    return lines


def render_section(section: SectionRecord) -> list[str]:
    return [rf"    \section{{{tex_escape(section['title'])}}}"]


def prepared_updates(data: ManifestRecord) -> dict[Path, str]:
    updates: dict[Path, str] = {}
    book = data["book"]
    book_path = ROOT / book["tex"]
    if not book_path.is_file():
        fail(f"Book TeX file is missing: {book['tex']}")
    content = read_text(book_path)
    try:
        content = replace_managed_block(content, "chapters", render_book(data))
        content = set_first_line(content, ENGINE_HEAD)
        content = set_title(content, book["title"])
        content = set_watermark(content, book["status"])
    except ManageNotesError as error:
        fail(f"{book['tex']}: {error}")
    updates[book_path] = content

    for chapter in book["chapters"]:
        chapter_path = ROOT / chapter["tex"]
        if chapter_path.is_file():
            content = read_text(chapter_path)
            try:
                content = replace_managed_block(
                    content, "sections", render_chapter(chapter)
                )
                content = set_first_line(content, ENGINE_HEAD)
                content = set_title(content, chapter["title"])
                content = set_watermark(content, chapter["status"])
            except ManageNotesError as error:
                fail(f"{chapter['tex']}: {error}")
            updates[chapter_path] = content
            chapter_appendix = chapter_path.parent / "appendix.tex"
            update_existing_root_head(
                updates,
                chapter_appendix,
                f"% !TeX root = {chapter['id']}.tex",
            )

        for section in chapter["sections"]:
            section_path = ROOT / section["tex"]
            if section_path.is_file():
                content = read_text(section_path)
                try:
                    content = replace_managed_block(
                        content, "section", render_section(section)
                    )
                    content = set_first_line(content, ENGINE_HEAD)
                    content = set_title(content, section["title"])
                    content = set_watermark(content, section["status"])
                except ManageNotesError as error:
                    fail(f"{section['tex']}: {error}")
                updates[section_path] = content

            body_path = safe_chapter_path(chapter["id"], section["id"], "text.tex")
            if body_path.is_file():
                body = set_first_line(
                    read_text(body_path), f"% !TeX root = {section['id']}.tex"
                )
                updates[body_path] = body
            section_appendix = body_path.parent / "appendix.tex"
            update_existing_root_head(
                updates,
                section_appendix,
                f"% !TeX root = {section['id']}.tex",
            )
    return updates


def update_existing_root_head(
    updates: dict[Path, str], path: Path, expected: str
) -> None:
    """Update an opt-in root head without adding heads to existing appendices."""
    if not path.is_file():
        return
    content = read_text(path)
    if content.startswith("% !TeX root = "):
        updates[path] = set_first_line(content, expected)


def changed_updates(updates: dict[Path, str]) -> dict[Path, str]:
    return {
        path: content
        for path, content in updates.items()
        if not path.exists() or read_text(path) != content
    }


def save_and_sync(
    data: ManifestRecord,
    *,
    dry_run: bool,
    description: str,
) -> None:
    normalize(data)
    validate_manifest(data)
    updates = prepared_updates(data)
    changes = changed_updates(updates)
    manifest_changed = manifest_text(data) != read_text(MANIFEST)
    if dry_run:
        print(f"Would {description}.")
        if manifest_changed:
            print(f"Would update {MANIFEST_NAME}.")
        for path in changes:
            print(f"Would synchronize {relative(path)}.")
        return

    atomic_write(MANIFEST, manifest_text(data))
    for path, content in changes.items():
        atomic_write(path, content)
    print(f"{description[:1].upper()}{description[1:]}.")


def synchronize(data: ManifestRecord, dry_run: bool) -> None:
    normalize(data)
    validate_manifest(data)
    updates = changed_updates(prepared_updates(data))
    normalized_manifest = manifest_text(data)
    manifest_changed = normalized_manifest != read_text(MANIFEST)
    if dry_run:
        if not manifest_changed and not updates:
            print("No synchronization changes are needed.")
            return
        if manifest_changed:
            print(f"Would normalize {MANIFEST_NAME}.")
        for path in updates:
            print(f"Would synchronize {relative(path)}.")
        return
    if manifest_changed:
        atomic_write(MANIFEST, normalized_manifest)
    for path, content in updates.items():
        atomic_write(path, content)
    if manifest_changed or updates:
        print(f"Synchronized {MANIFEST_NAME} and managed TeX files.")
    else:
        print("No synchronization changes were needed.")


def chapter_template(
    chapter_id: str, title: str, status: StatusRecord
) -> str:
    escaped = tex_escape(title)
    watermark = watermark_package_line(status)
    return rf"""% !TeX program = xelatex
% !TeX encoding = UTF-8
% !BIB program = biber
\documentclass[sectionlevel=chapter]{{noteformyself}}
% manage-notes:begin watermark
{watermark}
% manage-notes:end watermark

\input{{../../accessories/notation.tex}}
\addbibresource{{../../accessories/ref.bib}}
\newcommand{{\Yang}}[1]{{\textcolor{{red}}{{Yang: #1}}}}

\title{{{escaped}}}
\author{{Tianle Yang}}
\date{{\today}}
\authorpage{{\href{{https://www.tianleyang.com}}{{My Homepage}}}}

\setCJKfamilyfont{{lxgwwenkai}}{{LXGW WenKai}}
