)
SAFE_NUMBER_RE = re.compile(r"^[0-9A-Za-z.*(): -]+$")
SAFE_COUNTER_RE = re.compile(r"^[0-9]+$")
SAFE_CREF_TYPE_RE = re.compile(r"^[A-Za-z][A-Za-z0-9@_-]*$")
SAFE_ANCHOR_RE = re.compile(r"^[0-9A-Za-z:._-]*$")
